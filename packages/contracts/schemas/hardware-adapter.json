{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.feastcloud.org/v1/hardware-adapter.json",
  "title": "FeastCloud Hardware Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "license", "deviceClasses", "transports", "protocols", "permissions", "healthCheck"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "vendor": { "type": "string", "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "deviceClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["receipt-printer", "kitchen-printer", "cash-drawer", "barcode-scanner", "scale", "customer-display", "payment-terminal"] }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["usb", "serial", "tcp", "bluetooth", "operating-system"] }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" }
    },
    "configurationSchema": { "type": "string", "format": "uri-reference" },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalSeconds", "timeoutMilliseconds"],
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "timeoutMilliseconds": { "type": "integer", "minimum": 50, "maximum": 60000 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "uri", "sha256", "license"],
        "properties": {
          "platform": { "enum": ["linux", "darwin", "windows", "android"] },
          "architecture": { "enum": ["amd64", "arm64", "arm"] },
          "uri": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
