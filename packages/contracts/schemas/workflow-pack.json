{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.feastcloud.org/v1/workflow-pack.json",
  "title": "FeastCloud Workflow Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "serviceModes", "roles", "stations", "ticketFlow"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "serviceModes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["dine-in", "takeaway", "delivery", "room-service", "banquet", "staff-dining"] }
    },
    "roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "name": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "ticketFlow": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
    },
    "approvalPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "role"],
        "properties": {
          "action": { "type": "string" },
          "role": { "type": "string" },
          "limitMinor": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

