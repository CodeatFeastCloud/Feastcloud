{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.feastcloud.org/v1/country-pack.json",
  "title": "FeastCloud Country Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["countryCode", "name", "version", "currencies", "taxRegimes", "fiscalProfiles"],
  "properties": {
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
    },
    "roundingMode": { "enum": ["half-up", "half-even", "floor", "ceiling", "cash-rounding"] },
    "taxRegimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "name": { "type": "string" }
        }
      }
    },
    "fiscalProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "documentTypes", "numberingAuthority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "documentTypes": { "type": "array", "items": { "type": "string" } },
          "numberingAuthority": { "enum": ["device", "outlet", "legal-entity", "government"] }
        }
      }
    },
    "privacyPolicyReference": { "type": "string", "format": "uri-reference" }
  }
}

